{
  "name": "x-lookup",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only, no-auth Cloudflare Worker that turns public X/Twitter statuses, threads, profiles, search, and social graphs into compact Markdown or JSON for AI agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "alchemy:check": "vitest --run src/__tests__/alchemy-stack.test.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@typescript/native": "npm:typescript@^7.0.2",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.111",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.10.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
