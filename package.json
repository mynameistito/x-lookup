{
  "name": "x-lookup",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only, no-auth Cloudflare Worker that turns public X/Twitter statuses, threads, profiles, search, and social graphs into compact Markdown or JSON for AI agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy --stage prod --yes --adopt",
    "plan": "alchemy plan --stage prod",
    "destroy": "alchemy destroy --stage prod",
    "alchemy:check": "vitest --run __tests__/alchemy-stack.test.ts",
    "build:worker-preview": "bun scripts/build-worker-preview.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.1",
    "takumi-js": "2.16.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@types/bun": "^1.4.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.10.7",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.0"
}
