{
  "name": "x-lookup",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only, no-auth Cloudflare Worker that turns public X/Twitter statuses, threads, profiles, search, and social graphs into compact Markdown or JSON for AI agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy --stage prod --yes --adopt",
    "plan": "alchemy plan --stage prod",
    "destroy": "alchemy destroy --stage prod",
    "alchemy:check": "vitest --run __tests__/alchemy-stack.test.ts",
    "deploy:report": "bun scripts/github/deployment-report.ts",
    "deploy:output": "bun scripts/deployment/alchemy-output.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.21.0",
    "takumi-js": "2.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@effect/platform-bun": "4.0.0-rc.111",
    "@effect/platform-node": "4.0.0-rc.111",
    "@types/bun": "^1.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.111",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.10.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.0"
}
