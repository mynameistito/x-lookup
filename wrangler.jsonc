{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "x-lookup",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "CACHE_TTL_SECONDS": "3600"
  },
  "routes": [
    {
      "pattern": "x.mynameistito.com",
      "custom_domain": true
    }
  ]
}
